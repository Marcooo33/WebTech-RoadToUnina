# PostgreSQL connection string used by Prisma (see prisma.config.ts).
# Copy this file to .env and fill in your real Supabase credentials.
DATABASE_URL="my-postgres-connection-string"

# HTTP port used by the Express server (development fallback is 3000).
PORT=3000

# Runtime environment. Use "production" to enable the Secure cookie flag.
NODE_ENV=development

# Secret used to sign access JWTs (HS256). Must be at least 32 characters.
# Generate a long random value and never commit a real secret.
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Access token lifetime (jsonwebtoken `expiresIn` value). Default: 8h.
JWT_EXPIRES_IN="8h"

# How long a play session may go without a heartbeat before the backend treats
# it as expired (duration string). Default: 90s.
SESSION_HEARTBEAT_TIMEOUT="90s"

# Test-only. When "1", the server swaps the live MediaWiki integration for the
# deterministic fixture adapter used by the Playwright E2E suite (see e2e/).
# Leave at "0" (the default) for development and production.
E2E_FAKE_WIKIPEDIA="0"

# Test-only, optional. `npm run test:integration` ignores DATABASE_URL above and
# uses the local Docker database instead (default:
# postgresql://postgres:postgres@localhost:55432/roadtounina_integration).
# Set this only to point the integration suite at a different *local* database;
# the safety guard still requires host localhost, port 55432 and database name
# roadtounina_integration, so it can never reach Supabase or the E2E database.
# INTEGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/roadtounina_integration"
