# PostgreSQL connection string used by Prisma (see prisma.config.ts).
# Copy this file to .env and fill in your real Supabase credentials.
DATABASE_URL="my-postgres-connection-string"

# HTTP port used by the Express server (development fallback is 3000).
PORT=3000

# Runtime environment. Use "production" to enable the Secure cookie flag.
NODE_ENV=development

# Secret used to sign access JWTs (HS256). Must be at least 32 characters.
# Generate a long random value and never commit a real secret.
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Access token lifetime (jsonwebtoken `expiresIn` value). Default: 8h.
JWT_EXPIRES_IN="8h"

# Test-only. When "1", the server swaps the live MediaWiki integration for the
# deterministic fixture adapter used by the Playwright E2E suite (see e2e/).
# Leave at "0" (the default) for development and production.
E2E_FAKE_WIKIPEDIA="0"

# Production origin, without trailing slash/path, e.g. https://app.onrender.com.
# On Render, the automatically provided RENDER_EXTERNAL_URL is the fallback.
# Leave empty in development (the Angular dev proxy keeps requests same-origin).
PUBLIC_ORIGIN=""

# Keep 0 locally. In production set only after verifying Render's ingress hop
# count and forwarded-IP handling. Supported range 0..5; never trust arbitrary
# forwarding headers or use `true` on a directly accessible server.
TRUST_PROXY_HOPS=0

# Serve the compiled Angular app through Express. Defaults to 1 in production,
# 0 otherwise; leave unset locally to retain the separate Angular dev server.
# SERVE_FRONTEND=0

# Optional secret (at least 32 random characters) for GET /api/health/db via
# X-Health-Secret. Empty disables the endpoint. It performs only a minimal read;
# no scheduler is configured. Never reuse JWT_SECRET or expose this to Angular.
DB_HEALTH_SECRET=""
