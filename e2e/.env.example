# Copy to `.env`. These values are test-only and safe to commit as an example.

# Connection string for the local Dockerised E2E database (docker-compose.yml).
# The safety guard in global-setup.ts REQUIRES:
#   host = localhost | 127.0.0.1,  port = 55432,  database = roadtounina_e2e
# so the suite can never run migrations or TRUNCATE against Supabase.
E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/roadtounina_e2e"

# JWT secret the E2E backend signs tokens with. Test-only, must be >= 32 chars.
E2E_JWT_SECRET="e2e-test-only-jwt-secret-value-01234567890"
